# Klucz Groq (LLM + rozpoznawanie mowy Whisper): https://console.groq.com/keys
GROQ_API_KEY=

# Opcjonalnie: zapasowy dostawca LLM, używany gdy Groq zwróci limit (429): https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Token konta Discord, z którego Jarvis wysyła i czyta wiadomości
DISCORD_USER_TOKEN=

# Kontakty ustawia się w UI (Ustawienia → Kontakty). Przy pierwszym uruchomieniu
# wpisy CHANNEL_<NAZWA>=<id_kanału> z tego pliku są importowane automatycznie.

# Skrypty w scripts/usos
USOS_BASE_URL=https://apps.usos-szkol.pwr.edu.pl/
USOS_CONSUMER_KEY=
USOS_CONSUMER_SECRET=
USOS_ACCESS_TOKEN=
USOS_ACCESS_TOKEN_SECRET=
